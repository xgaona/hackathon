{
  "connectorId": "skkeda",
  "version": "1.0.0",
  "status": "ACTIVE",
  "capabilities": [
    {
      "capabilityId": "skkeda:booking.list",
      "connectorId": "skkeda",
      "mode": "READ",
      "risk": "LOW",
      "permissions": [],
      "status": "ACTIVE",
      "paramsSchema": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Fecha AAAA-MM-DD para filtrar; sin ella se listan todas las reservas activas"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "capabilityId": "skkeda:booking.create",
      "connectorId": "skkeda",
      "mode": "WRITE",
      "risk": "MEDIUM",
      "permissions": [],
      "status": "ACTIVE",
      "paramsSchema": {
        "type": "object",
        "required": [
          "kind",
          "date"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "puesto",
              "sala"
            ],
            "description": "puesto de trabajo o sala de reuniones"
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Fecha AAAA-MM-DD"
          },
          "resource": {
            "type": "string",
            "pattern": "^[PpSs]-[0-9]{1,3}$",
            "description": "Puesto (P-12) o sala (S-2); si no viene se asigna el primero libre"
          },
          "slot": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9]$",
            "description": "Solo salas: franja HH:MM-HH:MM en múltiplos de 30 minutos; sin ella, 08:00-18:00"
          },
          "floor": {
            "type": "integer",
            "enum": [
              2,
              3,
              4
            ],
            "description": "Piso: 2 (P-1 a P-14), 3 (P-15 a P-27), 4 (P-28 a P-40); sin puesto se asigna el primero libre del piso"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "capabilityId": "skkeda:booking.cancel",
      "connectorId": "skkeda",
      "mode": "WRITE",
      "risk": "MEDIUM",
      "permissions": [],
      "status": "ACTIVE",
      "paramsSchema": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^BK-[A-Z0-9-]{3,40}$",
            "description": "Código de la reserva, p. ej. BK-SYN-0001"
          }
        },
        "additionalProperties": false
      }
    }
  ]
}
