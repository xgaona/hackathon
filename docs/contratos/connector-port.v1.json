{
  "$id": "connector-port.v1",
  "title": "ConnectorPortV1",
  "description": "C1: puerto de conectores. Fuente de verdad de Connector, Capability, InvokeRequest, InvokeResult y KnowledgeItem.",
  "type": "object",
  "definitions": {
    "ErrorComun": {
      "title": "ErrorComun",
      "description": "Error común sin detalles internos.",
      "type": "object",
      "required": ["code", "message", "correlationId"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "correlationId": { "type": "string" }
      }
    },
    "Capability": {
      "title": "Capability",
      "description": "Acción o consulta que un conector expone.",
      "type": "object",
      "required": [
        "capabilityId",
        "connectorId",
        "mode",
        "risk",
        "permissions",
        "status",
        "paramsSchema"
      ],
      "properties": {
        "capabilityId": { "type": "string", "pattern": "^[a-z0-9-]+:[a-z]+\\.[a-zA-Z]+$" },
        "connectorId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "mode": { "enum": ["READ", "WRITE"] },
        "risk": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "permissions": {
          "description": "Grupos del token que pueden usarla; lista vacía = cualquier colaborador autenticado.",
          "type": "array",
          "items": { "type": "string" }
        },
        "status": { "enum": ["ACTIVE", "INACTIVE"] },
        "paramsSchema": { "type": "object" }
      }
    },
    "Connector": {
      "title": "Connector",
      "description": "Tercero o fuente integrada detrás de ConnectorPort.",
      "type": "object",
      "required": ["connectorId", "version", "status", "capabilities"],
      "properties": {
        "connectorId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "version": { "type": "string" },
        "status": { "enum": ["ACTIVE", "INACTIVE"] },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/Capability" }
        }
      }
    },
    "InvokeRequest": {
      "title": "InvokeRequest",
      "description": "Solicitud de ejecución de una capacidad.",
      "type": "object",
      "required": ["correlationId", "capabilityId", "userId", "params"],
      "properties": {
        "correlationId": { "type": "string", "minLength": 1 },
        "capabilityId": { "type": "string", "minLength": 1 },
        "userId": { "type": "string", "description": "Sale solo del token validado." },
        "params": { "type": "object" },
        "idempotencyKey": {
          "type": "string",
          "description": "Obligatoria si la capacidad es WRITE; sha256(userId + pendingActionId + summaryHash)."
        }
      }
    },
    "InvokeResult": {
      "title": "InvokeResult",
      "description": "Resultado normalizado de una invocación.",
      "type": "object",
      "required": ["correlationId", "status", "origin"],
      "properties": {
        "correlationId": { "type": "string" },
        "status": { "enum": ["OK", "NOT_FOUND", "DENIED", "CONFLICT", "FAILED", "UNAVAILABLE"] },
        "origin": { "enum": ["eva", "index", "live", "mock"] },
        "data": { "type": "object" },
        "sourceRef": { "type": "string" },
        "error": { "$ref": "#/definitions/ErrorComun" }
      }
    },
    "KnowledgeItem": {
      "title": "KnowledgeItem",
      "description": "Contenido que un conector expone para ingesta; solo GENERAL entra al índice.",
      "type": "object",
      "required": ["sourceRef", "connectorId", "title", "classification", "updatedAt"],
      "properties": {
        "sourceRef": { "type": "string" },
        "connectorId": { "type": "string" },
        "title": { "type": "string" },
        "classification": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
